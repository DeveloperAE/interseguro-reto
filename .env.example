# Mismo secreto en las dos APIs, mínimo 32 caracteres (las APIs no arrancan con uno más corto).
# Genera uno propio y ponlo solo en .env:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Origen del frontend. * sirve para la revisión local.
CORS_ORIGIN=*

# Solo detrás de un proxy (Render): el límite de login usa la IP de X-Forwarded-For.
# Sin proxy delante permitiría falsear la IP; en local queda apagado.
# TRUST_PROXY=true

# El compose sobreescribe NODE_API_URL dentro de api-go.
NODE_API_URL=http://localhost:3000
GO_API_URL=http://localhost:8080
